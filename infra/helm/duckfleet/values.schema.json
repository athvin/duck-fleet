{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Shape, not identity. workerImage/dbtImage/bucket/region/secretName once pinned one AWS account's registry, bucket, and region as const — which made the chart uninstallable by anyone else, contradicting a self-hosted warehouse for any single organization. The security property kept is that images are digest-pinned (an immutable @sha256 reference, never a mutable tag); the identity is the operator's. The development lane's own account/bucket/region stay pinned at the deploy, single-sourced in scripts/aws/target.env and asserted by tests/test_aws_ci.py, which is where that pin belongs.",
  "type": "object",
  "required": [
    "workerImage",
    "dbtImage"
  ],
  "properties": {
    "workerImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?/[a-zA-Z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "dbtImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?/[a-zA-Z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "storageClass": {
      "type": "string",
      "minLength": 1
    },
    "profiling": {
      "type": "boolean"
    },
    "platformWaitSeconds": {
      "type": "integer", "minimum": 0, "maximum": 600
    },
    "platformMigration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {"type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]*$"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "prepaidMicroUsd": {"type": "integer", "minimum": 1},
        "maxJobMicroUsd": {"type": "integer", "minimum": 1}
      }
    },
    "catalogWaitSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "dnsEgressCidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
      }
    },
    "isolatedCompute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSessionSeconds": {"type": "integer", "minimum": 60, "maximum": 7200},
        "readySeconds": {"type": "integer", "minimum": 5, "maximum": 600},
        "provisioningSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "quotaWaitSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "apiServerPorts": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "apiServerCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "workerReplicas": {
      "type": "object",
      "propertyNames": {
        "enum": ["small"]
      },
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 16}
    },
    "rateCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "computeMicroUsdPerUnitHour": {"type": "integer", "minimum": 1}
      }
    },
    "historyRetentionDays": {"type": "integer", "minimum": 0, "maximum": 3650},
    "lakePrefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.-]*[A-Za-z0-9]$"
    },
    "pgwire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {"type": "boolean"},
        "externalCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "ingressClassName": {"type": "string"},
        "controllerNamespace": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    }
  }
}
