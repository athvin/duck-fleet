{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "workerImage",
    "dbtImage"
  ],
  "properties": {
    "workerImage": {
      "type": "string",
      "pattern": "^797781631727\\.dkr\\.ecr\\.us-east-2\\.amazonaws\\.com/duckfleet-dev/worker@sha256:[a-f0-9]{64}$"
    },
    "dbtImage": {
      "type": "string",
      "pattern": "^797781631727\\.dkr\\.ecr\\.us-east-2\\.amazonaws\\.com/duckfleet-dev/dbt@sha256:[a-f0-9]{64}$"
    },
    "bucket": {
      "const": "duckfleet-dev-797781631727-us-east-2"
    },
    "region": {
      "const": "us-east-2"
    },
    "secretName": {
      "const": "duckfleet-dev"
    },
    "storageClass": {
      "const": "gp3"
    },
    "profiling": {
      "type": "boolean"
    },
    "catalogWaitSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "dnsEgressCidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
      }
    },
    "isolatedCompute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSessionSeconds": {"type": "integer", "minimum": 60, "maximum": 7200},
        "readySeconds": {"type": "integer", "minimum": 5, "maximum": 600},
        "apiServerCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "workerCpuRequests": {
      "type": "object",
      "propertyNames": {
        "enum": ["small", "medium"]
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "integer", "minimum": 1},
          {"type": "string", "pattern": "^[0-9]+m$"}
        ]
      }
    }
  }
}
