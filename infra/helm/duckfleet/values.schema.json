{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "workerImage",
    "dbtImage"
  ],
  "properties": {
    "workerImage": {
      "type": "string",
      "pattern": "^797781631727\\.dkr\\.ecr\\.us-east-2\\.amazonaws\\.com/duckfleet-dev/worker@sha256:[a-f0-9]{64}$"
    },
    "dbtImage": {
      "type": "string",
      "pattern": "^797781631727\\.dkr\\.ecr\\.us-east-2\\.amazonaws\\.com/duckfleet-dev/dbt@sha256:[a-f0-9]{64}$"
    },
    "bucket": {
      "const": "duckfleet-dev-797781631727-us-east-2"
    },
    "region": {
      "const": "us-east-2"
    },
    "secretName": {
      "const": "duckfleet-dev"
    },
    "storageClass": {
      "const": "gp3"
    },
    "profiling": {
      "type": "boolean"
    },
    "catalogWaitSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "dnsEgressCidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
      }
    },
    "isolatedCompute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSessionSeconds": {"type": "integer", "minimum": 60, "maximum": 7200},
        "readySeconds": {"type": "integer", "minimum": 5, "maximum": 600},
        "provisioningSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "quotaWaitSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "apiServerPorts": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "apiServerCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "workerCpuRequests": {
      "type": "object",
      "propertyNames": {
        "enum": ["small", "medium"]
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "integer", "minimum": 1},
          {"type": "string", "pattern": "^[0-9]+m$"}
        ]
      }
    },
    "workerReplicas": {
      "type": "object",
      "propertyNames": {
        "enum": ["small", "medium"]
      },
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 16}
    },
    "rateCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "computeMicroUsdPerUnitHour": {"type": "integer", "minimum": 1}
      }
    },
    "historyRetentionDays": {"type": "integer", "minimum": 0, "maximum": 3650},
    "lakePrefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.-]*[A-Za-z0-9]$"
    },
    "pgwire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {"type": "boolean"},
        "externalCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "ingressClassName": {"type": "string"},
        "controllerNamespace": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    }
  }
}
