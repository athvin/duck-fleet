{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Shape, not identity. workerImage/dbtImage/bucket/region/secretName once pinned one AWS account's registry, bucket, and region as const — which made the chart uninstallable by anyone else, contradicting a self-hosted warehouse for any single organization. The security property kept is that images are digest-pinned (an immutable @sha256 reference, never a mutable tag); the identity is the operator's. The development lane's own account/bucket/region stay pinned at the deploy, single-sourced in scripts/aws/target.env and asserted by tests/test_aws_ci.py, which is where that pin belongs.",
  "type": "object",
  "required": [
    "workerImage",
    "dbtImage"
  ],
  "definitions": {
    "admissionLimits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxQueuedQueries": {"type": "integer", "minimum": 1, "maximum": 65535},
        "maxRunningQueries": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maxQueuedPerPrincipal": {"type": "integer", "minimum": 1, "maximum": 65535},
        "maxRunningPerPrincipal": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "jobLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_seconds",
        "result_bytes",
        "result_rows",
        "retention_seconds"
      ],
      "properties": {
        "runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "result_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    }
  },
  "properties": {
    "databaseRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrator": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "worker": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "maintainer": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "catalog": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultPersistentGrant"
      ],
      "properties": {
        "defaultPersistentGrant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pool",
            "cpu",
            "memory",
            "disk"
          ],
          "properties": {
            "pool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$|^[a-z]$"
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}(Ki|Mi|Gi)$"
            },
            "disk": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}(Ki|Mi|Gi)$"
            }
          }
        }
      }
    },
    "workerImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?/[a-zA-Z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "dbtImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?/[a-zA-Z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "storageClass": {
      "type": "string",
      "minLength": 1
    },
    "profiling": {
      "type": "boolean"
    },
    "platformWaitSeconds": {
      "type": "integer", "minimum": 0, "maximum": 600
    },
    "platformMigration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {"type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]*$"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "prepaidMicroUsd": {"type": "integer", "minimum": 1},
        "maxJobMicroUsd": {"type": "integer", "minimum": 1}
      }
    },
    "catalogWaitSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "dnsEgressCidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
      }
    },
    "isolatedCompute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSessionSeconds": {"type": "integer", "minimum": 60, "maximum": 7200},
        "readySeconds": {"type": "integer", "minimum": 5, "maximum": 600},
        "provisioningSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "quotaWaitSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "apiServerPorts": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "apiServerCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "defaultPool": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$|^[a-z]$"},
    "persistentPools": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$|^[a-z]$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cpu", "memory", "disk"],
        "properties": {
          "cpu": {"type": "integer", "minimum": 1, "maximum": 65535},
          "memory": {"type": "string", "pattern": "^[1-9][0-9]{0,8}(Ki|Mi|Gi)$"},
          "disk": {"type": "string", "pattern": "^[1-9][0-9]{0,8}(Ki|Mi|Gi)$"},
          "workers": {"type": "integer", "minimum": 0, "maximum": 16},
          "maxSessionsPerWorker": {"type": "integer", "minimum": 1, "maximum": 1024},
        "jobLimits": {"$ref": "#/definitions/jobLimits"},
          "admission": {"$ref": "#/definitions/admissionLimits"}
        }
      }
    },
    "workerMaxSessions": {"type": "integer", "minimum": 1, "maximum": 1024},
    "workerQueueCapacity": {"type": "integer", "minimum": 1, "maximum": 4096},
    "workerMaxQueuedQueries": {"type": "integer", "minimum": 1, "maximum": 4096},
    "workerMaxQueuedBytes": {"type": "integer", "minimum": 1048576, "maximum": 268435456},
    "admissionLimits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "default": {"$ref": "#/definitions/admissionLimits"},
        "isolated": {"$ref": "#/definitions/admissionLimits"}
      }
    },
    "gatewayMaxSessions": {"type": "integer", "minimum": 1, "maximum": 4096},
    "workerReplicas": {
      "type": "object",
      "propertyNames": {
        "enum": ["small"]
      },
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 16}
    },
    "rateCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "computeMicroUsdPerUnitHour": {"type": "integer", "minimum": 1}
      }
    },
    "historyRetentionDays": {"type": "integer", "minimum": 0, "maximum": 3650},
    "lakePrefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.-]*[A-Za-z0-9]$"
    },
    "pgwire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {"type": "boolean"},
        "externalCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "ingressClassName": {"type": "string"},
        "controllerNamespace": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "prefix"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        }
      }
    },
    "jobPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ceilings": {
          "$ref": "#/definitions/jobLimits"
        },
        "isolated": {
          "$ref": "#/definitions/jobLimits"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limits",
            "queue_timeout_seconds",
            "format"
          ],
          "properties": {
            "limits": {
              "$ref": "#/definitions/jobLimits"
            },
            "queue_timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "format": {
              "const": "arrow_ipc_chunks"
            }
          }
        }
      }
    }
  }
}
