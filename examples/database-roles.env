# Template only: supply distinct generated passwords from your secret manager.
# Export these variables into the operator's shell; never mount this in compute.
DUCKFLEET_DATABASE_ADMIN_DSN='host=postgres port=5432 dbname=postgres user=database_admin password=REPLACE_ADMIN_PASSWORD'
DUCKFLEET_PLATFORM_DATABASE=platform
DUCKFLEET_LAKE_DATABASE=lake
DUCKFLEET_DB_MIGRATOR_ROLE=example_migrator
DUCKFLEET_DB_GATEWAY_ROLE=example_gateway
DUCKFLEET_DB_WORKER_ROLE=example_worker
DUCKFLEET_DB_MAINTAINER_ROLE=example_maintainer
DUCKFLEET_DB_CATALOG_ROLE=example_catalog
DUCKFLEET_DB_CATALOG_READER_ROLE=example_catalog_reader
DUCKFLEET_DB_MIGRATOR_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
DUCKFLEET_DB_GATEWAY_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
DUCKFLEET_DB_WORKER_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
DUCKFLEET_DB_MAINTAINER_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
DUCKFLEET_DB_CATALOG_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
DUCKFLEET_DB_CATALOG_READER_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
# Existing schema2 deployments require quiescence and explicit owner adoption.
DUCKFLEET_ADOPT_DATABASE_OWNER=no
