# Standalone process example; Compose already supplies local RustFS settings.
# Supply the same private result path to the gateway and workers. Give each
# component its own credentials: gateway GET/DELETE, worker PUT on this prefix.
DUCKFLEET_RESULT_DATA_PATH=s3://my-duckfleet/results/
DUCKFLEET_RESULT_LAKE_DATA_PATH=s3://my-duckfleet/lake/
DUCKFLEET_RESULT_AUTH_MODE=static
DUCKFLEET_RESULT_ACCESS_KEY=replace-with-component-access-key
DUCKFLEET_RESULT_SECRET_KEY=replace-with-component-secret
AWS_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
# Optional S3-compatible endpoint; HTTP is refused unless explicitly enabled.
# DUCKFLEET_RESULT_ENDPOINT=https://object-store.example.com
# DUCKFLEET_RESULT_ALLOW_HTTP=false
# Gateway only. Omission uses finite defaults; a named pool may lower each ceiling.
DUCKFLEET_JOB_POLICY_JSON={"ceilings":{"runtime_seconds":3600,"result_bytes":1073741824,"result_rows":10000000,"retention_seconds":86400},"defaults":{"limits":{"runtime_seconds":300,"result_bytes":1073741824,"result_rows":10000000,"retention_seconds":3600},"queue_timeout_seconds":120,"format":"arrow_ipc_chunks"}}
